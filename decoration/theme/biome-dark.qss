/* Main frame widget - transparent for rounded corner transparency */
biome_decoration--DecorationFrame#biomeFrame {
    background: transparent;
}

/* Titlebar */
biome_decoration--DecorationFrame#biomeFrame QWidget#biomeTitlebar {
    background: rgb(30, 30, 30);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-left: 1px solid rgb(10,10,10);
    border-right: 1px solid rgb(10,10,10);
    border-top: 1px solid rgb(10,10,10);
}

/* Title QLabel */
biome_decoration--DecorationFrame#biomeFrame QLabel#biomeTitle {
    background: transparent;
    color: rgb(235, 235, 235);
    font-size: 10pt;
    padding: 0px 6px;
}
biome_decoration--DecorationFrame#biomeFrame[focused="false"] QLabel#biomeTitle {
    color: rgb(150, 150, 150);
}

biome_decoration--DecorationBorder {
    background: rgb(30, 30, 30);
}

QWidget#biomeBorderLeft {
    min-width: 3px;
    border-left: 1px solid rgb(10,10,10);
}

QWidget#biomeBorderRight {
    min-width: 3px;
    border-right: 1px solid rgb(10,10,10);
}

QWidget#biomeBorderBottom {
    min-height: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    border-left: 1px solid rgb(10,10,10);
    border-right: 1px solid rgb(10,10,10);
    border-bottom: 1px solid rgb(10,10,10);
}

biome_decoration--DecorationFrame#biomeFrame[biomeMaximized="true"] QWidget#biomeTitlebar {
    border: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

biome_decoration--DecorationFrame#biomeFrame[biomeMaximized="true"] QWidget#biomeBorderLeft,
biome_decoration--DecorationFrame#biomeFrame[biomeMaximized="true"] QWidget#biomeBorderRight {
    min-width: 0px;
    border: none;
}

biome_decoration--DecorationFrame#biomeFrame[biomeMaximized="true"] QWidget#biomeBorderBottom {
    min-height: 0px;
    border: none;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

/* Titlebar window icon - a QToolButton (not a themed DecorationButton) so
   qproperty-iconSize controls its rendered size the same way it does for
   the min/max/close glyphs below, even though its actual icon comes from
   the window at runtime rather than a bundled theme asset. */
QToolButton#biomeTitleIcon {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px 4px;
    qproperty-iconSize: 16px 16px;
}

biome_decoration--DecorationButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 4px 8px;
    margin-top: 2px;
    margin-bottom: 2px;
    /* The icons are SVGs (scale-independent, no native pixel size to
       inherit), so this is a real design decision, not a value read back
       from the icon - see DecorationButton::sizeHint() being driven by
       this via padding/border above it. */
    qproperty-iconSize: 8px 8px;
}

biome_decoration--DecorationButton#biomeButtonMinimize {
    qproperty-icon: url(:/biome/decoration/icons/minimize-normal.svg);
}
biome_decoration--DecorationButton#biomeButtonMaximize {
    qproperty-icon: url(:/biome/decoration/icons/maximize-normal.svg);
}
biome_decoration--DecorationButton#biomeButtonClose {
    qproperty-icon: url(:/biome/decoration/icons/close-normal.svg);
    margin-right: 2px;
}

biome_decoration--DecorationFrame#biomeFrame[focused="false"] biome_decoration--DecorationButton#biomeButtonMinimize {
    qproperty-icon: url(:/biome/decoration/icons/minimize-dim.svg);
}
biome_decoration--DecorationFrame#biomeFrame[focused="false"] biome_decoration--DecorationButton#biomeButtonMaximize {
    qproperty-icon: url(:/biome/decoration/icons/maximize-dim.svg);
}
biome_decoration--DecorationFrame#biomeFrame[focused="false"] biome_decoration--DecorationButton#biomeButtonClose {
    qproperty-icon: url(:/biome/decoration/icons/close-dim.svg);
}
biome_decoration--DecorationFrame#biomeFrame[biomeMaximized="true"] biome_decoration--DecorationButton#biomeButtonMaximize {
    qproperty-icon: url(:/biome/decoration/icons/restore-normal.svg);
}
biome_decoration--DecorationFrame#biomeFrame[biomeMaximized="true"][focused="false"] biome_decoration--DecorationButton#biomeButtonMaximize {
    qproperty-icon: url(:/biome/decoration/icons/restore-dim.svg);
}

biome_decoration--DecorationButton:hover {
    background: rgba(60, 60, 60, 70%);
    border: 1px solid rgba(70, 70, 70, 70%);
}

biome_decoration--DecorationButton:pressed {
    background: rgba(45, 45, 45, 70%);
    border: 1px solid rgba(55, 55, 55, 70%);
}

biome_decoration--DecorationButton#biomeButtonClose:hover {
    background: rgba(200, 0, 0, 70%);
    border: 1px solid rgba(230, 0, 0, 70%);
}

biome_decoration--DecorationButton#biomeButtonClose:pressed {
    background: rgba(170, 0, 0, 70%);
    border: 1px solid rgba(180, 0, 0, 70%);
}

QWidget#biomeSwitcherRoot {
    background: transparent;
}

QFrame#biomeSwitcherPanel {
    background: rgb(30, 30, 30);
    border: 1px solid rgba(100, 100, 100, 40%);
    border-radius: 6px;
    qproperty-panelPadding: 14;
}

QToolButton#biomeSwitcherIcon {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 6px;
    qproperty-iconSize: 48px 48px;
}

QToolButton#biomeSwitcherIcon[selected="true"] {
    background: rgb(60, 60, 60);
    border: 1px solid rgb(90, 90, 90);
}

QLabel#biomeSwitcherTitleLabel {
    background: transparent;
    color: white;
    font-size: 10pt;
    padding-top: 10px;
    qproperty-alignment: AlignHCenter;
}
